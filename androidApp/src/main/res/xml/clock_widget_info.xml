<?xml version="1.0" encoding="utf-8"?><!-- One "life minute" is days to weeks long, so a daily update is enough. Profile changes trigger an extra update. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="de.chrisander.timeoflife.widget.settings.WidgetSettingsActivity"
    android:description="@string/clock_widget_description"
    android:initialLayout="@layout/widget"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="80dp"
    android:minResizeHeight="80dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="86400000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
